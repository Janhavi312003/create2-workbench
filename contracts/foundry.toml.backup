[profile.default]
src = "src"
out = "out"
libs = ["lib"]
solc = "0.8.20"
optimizer = true
optimizer_runs = 200
remappings = ["@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/"]

[rpc_endpoints]
rootstock_testnet = "${ROOTSTOCK_TESTNET_RPC}"
rootstock_mainnet = "${ROOTSTOCK_MAINNET_RPC}"

[etherscan]
rootstock_testnet = { key = "${BLOCKSCOUT_API_KEY}", url = "https://rootstock-testnet.blockscout.com/api" }


[profile.default]
remappings = ["@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/"]
